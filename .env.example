# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project Settings -> Environment Variables.

# Browser-safe Supabase settings (VITE_ variables are bundled into the client).
# Use the project URL and the anon / publishable key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" (default) shows clearly labelled demonstration data.
# "supabase" reads live data and requires staff sign-in. Needs the two values above.
VITE_DATA_SOURCE=mock

# Inventory shows PHILRADS IMS stock, pushed by the IMS to /api/ims-sync (docs/ims-sync.md).
# PHILRADS IMS address for "Open in IMS" links, no trailing slash, e.g. https://philrads-ims.page.gd
VITE_IMS_URL=

# --- Server-only (Vercel functions). No VITE_ prefix, so never sent to the browser. ---
# Shared secret with the IMS (PORTAL_SYNC_KEY in its config.php). Long and random.
IMS_SYNC_KEY=
# Used only by /api/ims-sync to store snapshots: Supabase -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to VITE_SUPABASE_URL.
SUPABASE_URL=

# NEVER add a Supabase service-role key, Google client secret, or Google service-account key
# to a VITE_ variable. Server-only secrets belong in Vercel server functions (see docs/google-drive.md).
