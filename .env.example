# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project Settings -> Environment Variables.

# Browser-safe Supabase settings (VITE_ variables are bundled into the client).
# Use the project URL and the anon / publishable key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" (default) shows clearly labelled demonstration data.
# "supabase" reads live data and requires staff sign-in. Needs the two values above.
VITE_DATA_SOURCE=mock

# NEVER add a Supabase service-role key, Google client secret, or Google service-account key
# to a VITE_ variable. Server-only secrets belong in Vercel server functions (see docs/google-drive.md).
